exports[`sidebar shell snapshots > renders the expanded column in the default locale (zh, no setLocale) 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root quietBars"
    style="width: 300px;"
  >
    <div
      class="logoRow"
      data-window-drag="true"
    >
      <button
        aria-label="新建会话"
        class="brand wide"
        type="button"
      >
        <span
          aria-hidden="true"
          class="brandIdentity"
        >
          <span
            class="brandMark"
          >
            <div
              data-slot="sidebar.brand.mark"
              style="display: contents;"
            >
              <span
                class="copyVersion"
                data-copy-version="true"
              >
                <img
                  alt=""
                  aria-hidden="true"
                  height="24"
                  src="/anton-mark.png"
                  style="display: block; border-radius: 6.720000000000001px;"
                  width="24"
                />
              </span>
            </div>
          </span>
          <span
            class="brandName"
          >
            <div
              data-slot="sidebar.brand.name"
              style="display: contents;"
            >
              <span
                class="localBuildBrand copyVersion"
                data-copy-version="true"
              >
                <span
                  class="localBuildTitle"
                >
                  DSH 本地构建
                </span>
                <span
                  class="buildVersion"
                >
                  1.2.3-rc.4-abc1234-dirty
                </span>
              </span>
