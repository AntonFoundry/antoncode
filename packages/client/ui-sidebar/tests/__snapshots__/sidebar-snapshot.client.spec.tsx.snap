          width="16"
        />
      </button>
    </div>
    <button
      aria-label="新建工作区"
      class="newWorkspace"
      type="button"
    >
      <svg
        aria-hidden="true"
        data-content="c4dd58be"
        data-icon="dsw-icon-project-add-outline-medium"
        height="14"
        width="14"
      />
      <span
        class="newWorkspaceLabel wide"
      >
        新建工作区
      </span>
    </button>
    <div
      class="regionArea"
    >
      <div
        data-slot="sidebar.workspaces"
        style="display: contents;"
      />
    </div>
    <div
      aria-label="调整记忆面板大小"
      aria-orientation="horizontal"
      class="memoryResizer"
      role="separator"
      title="拖动以调整执行树大小"
    />
    <div
      class="memoryArea"
    >
      <div
        data-slot="sidebar.memory"
        style="display: contents;"
      />
    </div>
    <div
      class="footArea"
    >
      <div
        class="footerActions"
      >
        <div
          data-slot="sidebar.footer.action"
          style="display: contents;"
        />
      </div>
      <div
        class="settingsArea"
      >
        <div
          data-slot="sidebar.settings"
          style="display: contents;"
        />
      </div>
    </div>
  </div>
</div>
`;
