{
  "name": "@deepseek-ai/dsh-web-search-browser",
  "description": "Scrape-backed search provider (Bing/Brave/DuckDuckGo via Playwright) for the DeepSeek Harness web capability seam (ctx.web)",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/web/web-search-browser"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "locale/*.json"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-web": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "axios": "^1.6.8",
    "cheerio": "^1.0.0-rc.12",
    "p-limit": "^7.3.1",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-web": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  }
}
