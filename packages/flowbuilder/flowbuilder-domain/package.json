{
  "name": "@deepseek-ai/dsh-flowbuilder-domain",
  "description": "Flowbuilder durable vocabulary: flow definitions, block library entries, run records, zod schemas, DAG validation, and the flowbuilder storage domain spec",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/flowbuilder/flowbuilder-domain"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./schema": {
      "types": "./lib/types/schema.d.ts",
      "default": "./lib/types/schema.js"
    },
    "./spec": {
      "types": "./lib/types/spec.d.ts",
      "default": "./lib/types/spec.js"
    },
    "./dag": {
      "types": "./lib/types/dag.d.ts",
      "default": "./lib/types/dag.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-storage-domain": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-storage-domain": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  }
}
